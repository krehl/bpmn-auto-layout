          <dc:Bounds x="941" y="316" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_CreditCheck" bpmnElement="CreditCheck">
        <dc:Bounds x="756" y="916" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_CheckStock" bpmnElement="CheckStock">
        <dc:Bounds x="756" y="676" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_OutcomeGW" bpmnElement="OutcomeGW" isMarkerVisible="true">
