        <dc:Bounds x="2642" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_ShippedEnd" bpmnElement="ShippedEnd">
        <dc:Bounds x="2474" y="698" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2466" y="739" width="53" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_ConfirmedEnd" bpmnElement="ConfirmedEnd">
        <dc:Bounds x="2842" y="342" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2821" y="383" width="78" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_F_start" bpmnElement="F_start">
        <di:waypoint x="156" y="200" />
        <di:waypoint x="256" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_F_enter" bpmnElement="F_enter">
        <di:waypoint x="356" y="200" />
        <di:waypoint x="456" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_F_validNo" bpmnElement="F_validNo">
        <di:waypoint x="506" y="200" />
        <di:waypoint x="613" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="550" y="178" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_F_toCredit" bpmnElement="F_toCredit">
        <di:waypoint x="631" y="385" />
        <di:waypoint x="631" y="956" />
        <di:waypoint x="756" y="956" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_F_credit" bpmnElement="F_credit">
        <di:waypoint x="856" y="956" />
        <di:waypoint x="981" y="956" />
        <di:waypoint x="981" y="385" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_F_join" bpmnElement="F_join">
        <di:waypoint x="1006" y="360" />
        <di:waypoint x="1106" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_F_outCredit" bpmnElement="F_outCredit">
        <di:waypoint x="1131" y="385" />
        <di:waypoint x="1131" y="956" />
        <di:waypoint x="1256" y="956" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1136" y="713" width="48" height="28" />
