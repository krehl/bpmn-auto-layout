          <dc:Bounds x="1810" y="156" width="43" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Fulfill" bpmnElement="Fulfill">
        <dc:Bounds x="1956" y="676" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_WaitGW" bpmnElement="WaitGW" isMarkerVisible="true">
        <dc:Bounds x="2156" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2153" y="142" width="56" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
